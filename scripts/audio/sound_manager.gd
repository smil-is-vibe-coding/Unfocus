extends Node
## Autoload "Sound": audio buses, one-shot SFX (2D and positional 3D), looping
## emitters and crossfading music. All audio is generated by
## tools/generate_audio.py (original, royalty-free).

const DIR := "res://audio/"

## Per-sound mix level (dB) so callers don't have to care about balance.
const LEVELS := {
	"gun_shot": -4.0, "bullet_hit": -2.0, "bullet_ricochet": -8.0,
	"missile_launch": 0.0, "missile_loop": -6.0, "explosion": 2.0, "explosion_big": 3.0,
	"boost": 0.0, "hook_fire": 0.0, "hook_attach": -1.0, "hook_snap": 1.0,
	"invis_on": -1.0, "invis_off": -3.0, "repair": -2.0,
	"shield_hit": 0.0, "shield_scrape": -6.0, "shield_break": 1.0, "shield_refill": -1.0,
	"fall": -2.0, "respawn": -4.0, "hit_player": -3.0,
	"pickup_boost": -3.0, "pickup_machine_gun": -2.0, "pickup_invisibility": -2.0,
	"pickup_hookshot": -3.0, "pickup_missile": -7.0, "pickup_repair": -3.0, "pickup_forcefield": -2.0,
	"ui_move": -8.0, "ui_select": -3.0,
	"countdown_beep": -2.0, "go_beep": 0.0, "perfect_start": 0.0, "stall": 0.0,
	"lap": -2.0, "finish": 0.0,
}

const LOOPS := [
	"engine_viper", "engine_dart", "engine_manta", "engine_titan", "engine_wraith",
	"engine_roar", "afterburner", "airbrake", "missile_loop", "music_race", "music_hangar",
]

const PICKUP_SOUNDS := {
	PowerUp.Type.BOOST: "pickup_boost",
	PowerUp.Type.MACHINE_GUN: "pickup_machine_gun",
	PowerUp.Type.INVISIBILITY: "pickup_invisibility",
	PowerUp.Type.HOOKSHOT: "pickup_hookshot",
	PowerUp.Type.MISSILE: "pickup_missile",
	PowerUp.Type.REPAIR: "pickup_repair",
	PowerUp.Type.FORCEFIELD: "pickup_forcefield",
}

@export var music_volume_db := -9.0

var _streams := {}
var _music_a: AudioStreamPlayer
var _music_b: AudioStreamPlayer
var _music_current := ""


func _ready() -> void:
	process_mode = Node.PROCESS_MODE_ALWAYS
	_setup_buses()
	_music_a = _make_music_player()
	_music_b = _make_music_player()


func _setup_buses() -> void:
	if AudioServer.get_bus_index("SFX") != -1:
		return
	for bus_name in ["Music", "SFX", "Engines"]:
		AudioServer.add_bus()
		var idx := AudioServer.bus_count - 1
		AudioServer.set_bus_name(idx, bus_name)
		AudioServer.set_bus_send(idx, "Master")
	AudioServer.set_bus_volume_db(AudioServer.get_bus_index("Engines"), -3.0)

	# Glue the SFX together and keep stacked explosions from clipping.
	var comp := AudioEffectCompressor.new()
	comp.threshold = -14.0
	comp.ratio = 3.0
	comp.attack_us = 2000.0
	comp.release_ms = 180.0
	comp.gain = 2.0
	AudioServer.add_bus_effect(AudioServer.get_bus_index("SFX"), comp)

	var limiter := AudioEffectHardLimiter.new()
	limiter.ceiling_db = -0.5
	limiter.pre_gain_db = 1.5
	AudioServer.add_bus_effect(0, limiter)


func get_stream(sound: String) -> AudioStream:
	if _streams.has(sound):
		return _streams[sound]
	var path := DIR + sound + ".wav"
	if not ResourceLoader.exists(path):
		push_warning("Sound: missing %s" % path)
		_streams[sound] = null
		return null
	var s: AudioStream = load(path)
	if s is AudioStreamWAV and sound in LOOPS:
		var wav := s as AudioStreamWAV
		wav.loop_mode = AudioStreamWAV.LOOP_FORWARD
		wav.loop_begin = 0
		wav.loop_end = int(wav.get_length() * wav.mix_rate)
	_streams[sound] = s
	return s


func level(sound: String) -> float:
	return LEVELS.get(sound, 0.0)


## Non-positional one-shot (UI, player-only feedback).
func play(sound: String, volume_db := 0.0, pitch := 1.0, bus := "SFX") -> AudioStreamPlayer:
	var stream := get_stream(sound)
	if stream == null:
		return null
	var p := AudioStreamPlayer.new()
	p.stream = stream
	p.volume_db = level(sound) + volume_db
	p.pitch_scale = pitch
	p.bus = bus
	add_child(p)
	p.finished.connect(p.queue_free)
	p.play()
	return p


## Positional one-shot at a world position.
func play_at(sound: String, pos: Vector3, volume_db := 0.0, pitch := 1.0, unit_size := 12.0) -> AudioStreamPlayer3D:
	var stream := get_stream(sound)
	var scene := get_tree().current_scene
	if stream == null or scene == null:
		return null
	var p := AudioStreamPlayer3D.new()
	p.stream = stream
	p.volume_db = level(sound) + volume_db
	p.pitch_scale = pitch
	p.unit_size = unit_size
	p.max_distance = 400.0
	p.bus = "SFX"
	p.attenuation_filter_cutoff_hz = 9000.0
	p.attenuation_filter_db = -12.0
	scene.add_child(p)
	p.global_position = pos
	p.finished.connect(p.queue_free)
	p.play()
	return p


## Looping positional emitter parented to `node` (engines, missile hiss).
func attach_loop(sound: String, node: Node3D, volume_db := 0.0, unit_size := 10.0, bus := "SFX") -> AudioStreamPlayer3D:
	var stream := get_stream(sound)
	if stream == null:
		return null
	var p := AudioStreamPlayer3D.new()
	p.stream = stream
	p.volume_db = level(sound) + volume_db
	p.unit_size = unit_size
	p.max_distance = 350.0
	p.bus = bus
	p.doppler_tracking = AudioStreamPlayer3D.DOPPLER_TRACKING_PHYSICS_STEP
	node.add_child(p)
	p.play(randf() * 1.5)  # Random start so identical loops don't phase.
	return p


func pickup(type: int, pos: Vector3, is_player: bool) -> void:
	var sound: String = PICKUP_SOUNDS.get(type, "")
	if sound == "":
		return
	if is_player:
		play(sound)
	else:
		play_at(sound, pos, -2.0)


# --- Music ------------------------------------------------------------------------

func _make_music_player() -> AudioStreamPlayer:
	var p := AudioStreamPlayer.new()
	p.bus = "Music"
	p.volume_db = -80.0
	add_child(p)
	return p


func play_music(track: String, fade_time := 1.5) -> void:
	if track == _music_current:
		return
	_music_current = track
	var stream := get_stream(track)
	var old := _music_a if _music_a.playing else _music_b
	var new := _music_b if old == _music_a else _music_a
	if stream:
		new.stream = stream
		new.volume_db = -40.0
		new.play()
		create_tween().tween_property(new, "volume_db", music_volume_db, fade_time)
	if old.playing:
		var tw := create_tween()
		tw.tween_property(old, "volume_db", -60.0, fade_time)
		tw.tween_callback(old.stop)
